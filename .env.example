# ==============================================================
# Frontend (Next.js on Vercel) environment variables
# Copy to `.env.local` and fill real values. NEVER commit .env.local
# ==============================================================

# URL of the deployed Cloudflare Worker that proxies uploads
# to Internet Archive (IAS3). See worker/README.md
NEXT_PUBLIC_IA_UPLOAD_URL=

# Optional: shared upload token — required only if the Worker
# was configured with the UPLOAD_TOKEN secret enabled.
#NEXT_PUBLIC_IA_UPLOAD_TOKEN=

# --------------------------------------------------------------
# Firebase (existing configuration, see deploy.ps1 / FIREBASE_GUIDE.md)
# --------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
